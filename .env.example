# Copy this file to .env for local development.
#
# Set the real value in your host's dashboard, never in committed code:
#   Vercel: Project > Settings > Environment Variables -> DISCORD_WEBHOOK_URL
# Do NOT prefix it with VITE_ — that would ship it to the browser bundle.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_id/your_token

# Optional, only if frontend + API are on different domains:
# VITE_CONTACT_API_URL=https://your-project.vercel.app/api/contact
